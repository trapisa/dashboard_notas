<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notas Fiscais Cedidas — Trapisa/LD</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{
  --bg:#f2f4f7; --panel:#ffffff; --panel2:#eceff3; --border:#dde2e9;
  --text:#171b24; --muted:#646d7d;
  --accent:#28527a; --accent-soft:#e4ecf4;
  --green:#1c8f57; --green-soft:#e2f5ea;
  --amber:#a8680a; --amber-soft:#faedd8;
  --red:#bd3b50; --red-soft:#fbe6ea;
  --font-sans:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-mono:'IBM Plex Mono',ui-monospace,'SF Mono',Menlo,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0e1116; --panel:#161a22; --panel2:#1d2129; --border:#2a2f3a;
    --text:#e7eaf0; --muted:#8b93a4;
    --accent:#8fb6df; --accent-soft:#1f2e3f;
    --green:#4fcf8c; --green-soft:#173626;
    --amber:#e0a856; --amber-soft:#3a2c14;
    --red:#f0788c; --red-soft:#3a1c22;
  }
}
:root[data-theme="dark"]{
  --bg:#0e1116; --panel:#161a22; --panel2:#1d2129; --border:#2a2f3a;
  --text:#e7eaf0; --muted:#8b93a4;
  --accent:#8fb6df; --accent-soft:#1f2e3f;
  --green:#4fcf8c; --green-soft:#173626;
  --amber:#e0a856; --amber-soft:#3a2c14;
  --red:#f0788c; --red-soft:#3a1c22;
}
*{box-sizing:border-box;}
[hidden]{display:none !important;}
html,body{height:100%;}
body{
  margin:0; background:var(--bg); color:var(--text);
  font-family:var(--font-sans);
  padding-inline:16px; padding-block:20px 40px;
}
.wrap{max-width:1180px; margin:0 auto;}
header{margin-bottom:22px; display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;}
h1{font-size:1.35rem; margin:0; font-weight:650; letter-spacing:-0.01em;}
.subtitle{color:var(--muted); font-size:0.85rem;}
.logout-btn{
  background:none; border:1px solid var(--border); color:var(--muted); border-radius:8px;
  padding:7px 12px; font-size:0.8rem; font-family:inherit; cursor:pointer;
}
.logout-btn:hover{color:var(--text); border-color:var(--muted);}

.update-bar{
  display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:14px;
  background:var(--panel); border:1px solid var(--border); border-radius:12px;
  padding:12px 14px;
}
.update-bar .info{flex:1; min-width:220px;}
.update-bar .info .t{font-size:0.85rem; font-weight:600;}
.update-bar .info .d{font-size:0.76rem; color:var(--muted); margin-top:2px;}
.update-bar .last{font-size:0.72rem; color:var(--muted); margin-top:4px;}
.update-bar input[type=file]{display:none;}
.btn{
  display:inline-flex; align-items:center; gap:6px; cursor:pointer;
  background:var(--accent-soft); color:var(--accent); border:1px solid var(--accent);
  border-radius:8px; padding:8px 14px; font-size:0.83rem; font-weight:600; font-family:inherit;
}
.btn:hover{filter:brightness(1.05);}
.btn:disabled{opacity:0.55; cursor:not-allowed;}
.status-msg{font-size:0.78rem; padding:2px 0; min-height:1.1em;}
.status-msg.success{color:var(--green);}
.status-msg.error{color:var(--red);}
.status-msg.warning{color:var(--amber);}
.status-msg.pending{color:var(--muted);}

.filters{
  display:flex; gap:12px; flex-wrap:wrap; margin-bottom:18px;
  background:var(--panel); border:1px solid var(--border); border-radius:12px;
  padding:14px;
}
.filter-group{display:flex; flex-direction:column; gap:5px; min-width:160px; flex:1;}
.filter-group label{font-size:0.7rem; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; font-weight:600;}
select{
  background:var(--panel2); color:var(--text); border:1px solid var(--border);
  border-radius:8px; padding:9px 10px; font-size:0.88rem; font-family:inherit;
}
select:focus-visible, button:focus-visible{outline:2px solid var(--accent); outline-offset:1px;}

.cards{display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:12px; margin-bottom:20px;}
.card{
  background:var(--panel); border:1px solid var(--border); border-radius:12px;
  padding:16px 18px;
}
.card .label{font-size:0.74rem; color:var(--muted); margin-bottom:7px; font-weight:500;}
.card .value{font-size:1.55rem; font-weight:650; letter-spacing:-.015em; font-family:var(--font-mono);}
.card.highlight{background:var(--accent-soft); border-color:var(--accent);}
.card.highlight .value{color:var(--accent);}

.section{
  background:var(--panel); border:1px solid var(--border); border-radius:12px;
  margin-bottom:16px; overflow:hidden;
}
.section-header{
  padding:14px 18px; border-bottom:1px solid var(--border);
  display:flex; justify-content:space-between; align-items:baseline; gap:10px; flex-wrap:wrap;
}
.section-header h2{font-size:0.95rem; margin:0; font-weight:600;}
.section-header .hint{font-size:0.76rem; color:var(--muted);}

.table-scroll{max-height:520px; overflow:auto;}
table{width:100%; border-collapse:collapse; font-size:0.85rem;}
th{
  text-align:left; padding:10px 14px; color:var(--muted); font-weight:600;
  font-size:0.7rem; text-transform:uppercase; letter-spacing:.05em;
  border-bottom:1px solid var(--border); position:sticky; top:0; background:var(--panel);
}
td{padding:9px 14px; border-bottom:1px solid var(--border); vertical-align:top;}
tr:last-child td{border-bottom:none;}
tr.subtotal-row td{background:var(--panel2); font-weight:650;}
tr.grand-total td{background:var(--accent-soft); font-weight:700; font-size:0.92rem; color:var(--accent);}
tbody tr:hover td{background:color-mix(in srgb, var(--text) 4%, transparent);}
.right{text-align:right;}
.mono{font-family:var(--font-mono); font-variant-numeric:tabular-nums;}

.badge{
  display:inline-block; padding:3px 9px; border-radius:99px; font-size:0.72rem; font-weight:600;
  white-space:nowrap;
}
.badge.aberto{background:var(--amber-soft); color:var(--amber);}
.badge.paga{background:var(--green-soft); color:var(--green);}
.badge.pago_nota{background:var(--red-soft); color:var(--red); cursor:help; border-bottom:1px dashed var(--red);}

.empty-state{padding:34px; text-align:center; color:var(--muted); font-size:0.88rem;}

.legend{padding:12px 18px; font-size:0.78rem; color:var(--muted); border-top:1px solid var(--border); line-height:1.55;}
.legend b{color:var(--text);}

footer{color:var(--muted); font-size:0.74rem; text-align:center; margin-top:22px;}

@media (max-width:640px){
  .cards{grid-template-columns:1fr 1fr;}
  .card .value{font-size:1.15rem;}
  th, td{padding:8px 8px; font-size:0.78rem;}
}

.login-wrap{
  min-height:100vh; min-height:100dvh; display:flex; align-items:center; justify-content:center;
  padding:16px;
}
.login-card{
  width:100%; max-width:360px; background:var(--panel); border:1px solid var(--border);
  border-radius:14px; padding:28px 26px; box-shadow:0 8px 30px color-mix(in srgb, var(--text) 8%, transparent);
}
.login-card .lock{font-size:1.6rem; margin-bottom:10px;}
.login-card h1{font-size:1.1rem; margin:0 0 4px 0; font-weight:650;}
.login-card .sub{font-size:0.8rem; color:var(--muted); margin-bottom:20px; line-height:1.4;}
.login-field{display:flex; flex-direction:column; gap:5px; margin-bottom:14px;}
.login-field label{font-size:0.7rem; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; font-weight:600;}
.login-field input{
  background:var(--panel2); color:var(--text); border:1px solid var(--border);
  border-radius:8px; padding:10px 11px; font-size:0.92rem; font-family:inherit;
}
.login-field input:focus-visible{outline:2px solid var(--accent); outline-offset:1px;}
.login-submit{
  width:100%; margin-top:6px; background:var(--accent); color:#fff; border:none;
  border-radius:8px; padding:11px; font-size:0.9rem; font-weight:650; font-family:inherit; cursor:pointer;
}
.login-submit:hover{filter:brightness(1.08);}
.login-submit:disabled{opacity:0.6; cursor:not-allowed;}
.login-error{font-size:0.8rem; color:var(--red); margin-top:12px; min-height:1.1em;}
.login-note{font-size:0.72rem; color:var(--muted); margin-top:18px; line-height:1.45; border-top:1px solid var(--border); padding-top:14px;}

.loading-note{padding:40px; text-align:center; color:var(--muted); font-size:0.9rem;}
</style>
</head>
<body>
<div class="login-wrap" id="login-screen">
  <div class="login-card">
    <div class="lock">🔒</div>
    <h1>Acesso restrito</h1>
    <div class="sub">Notas fiscais cedidas — Trapisa / LD. Entre com as credenciais fornecidas para continuar.</div>
    <form id="login-form" autocomplete="off">
      <div class="login-field">
        <label for="login-user">Usuário</label>
        <input type="text" id="login-user" autocomplete="username" autocapitalize="off" spellcheck="false" required>
      </div>
      <div class="login-field">
        <label for="login-pass">Senha</label>
        <input type="password" id="login-pass" autocomplete="current-password" required>
      </div>
      <button type="submit" class="login-submit" id="login-submit">Entrar</button>
      <div class="login-error" id="login-error"></div>
    </form>
    <div class="login-note">Acesso individual — não compartilhe usuário e senha. A sessão expira ao fechar esta aba.</div>
  </div>
</div>

<div id="app-content" hidden>
<div class="wrap">
  <header>
    <div>
      <h1>Notas Fiscais Cedidas</h1>
      <div class="subtitle">Trapisa / LD — valores cedidos a fundos e situação de pagamento</div>
    </div>
    <button class="logout-btn" id="logout-btn" type="button">Sair</button>
  </header>

  <div class="update-bar">
    <div class="info">
      <div class="t">Atualizar planilha</div>
      <div class="d">Carregue um novo Notas_Fiscais_Emitidas.xlsx para recalcular e salvar os dados para todos.</div>
      <div class="last" id="last-update">—</div>
      <div class="status-msg" id="upload-status"></div>
    </div>
    <label class="btn" for="file-input">Carregar planilha (.xlsx)</label>
    <input type="file" id="file-input" accept=".xlsx">
  </div>

  <div class="filters">
    <div class="filter-group">
      <label for="f-empresa">Empresa</label>
      <select id="f-empresa">
        <option value="todas">Todas</option>
        <option value="Trapisa">Trapisa</option>
        <option value="LD">LD</option>
      </select>
    </div>
    <div class="filter-group">
      <label for="f-fundo">Fundo</label>
      <select id="f-fundo"><option value="todos">Todos</option></select>
    </div>
    <div class="filter-group">
      <label for="f-status">Status</label>
      <select id="f-status">
        <option value="aberto">Em aberto</option>
        <option value="paga">Pagas</option>
        <option value="todas">Todas</option>
      </select>
    </div>
  </div>

  <div class="cards">
    <div class="card highlight">
      <div class="label">Total cedido (filtro atual)</div>
      <div class="value mono" id="c-total">—</div>
    </div>
    <div class="card">
      <div class="label">Quantidade de notas</div>
      <div class="value mono" id="c-count">—</div>
    </div>
    <div class="card">
      <div class="label">Quantidade de fundos</div>
      <div class="value mono" id="c-funds">—</div>
    </div>
  </div>

  <div class="section">
    <div class="section-header">
      <h2>Total por fundo e empresa</h2>
      <div class="hint">Subtotal por fundo (soma das empresas) e total geral</div>
    </div>
    <div class="table-scroll">
      <table id="tbl-fundos">
        <thead>
          <tr><th>Fundo</th><th>Empresa</th><th class="right">Qtd. notas</th><th class="right">Valor total</th></tr>
        </thead>
        <tbody id="tbl-fundos-body"></tbody>
      </table>
    </div>
  </div>

  <div class="section">
    <div class="section-header">
      <h2>Detalhe das notas</h2>
      <div class="hint" id="detail-hint">Notas que compõem os totais acima</div>
    </div>
    <div class="table-scroll">
      <table id="tbl-detalhe">
        <thead>
          <tr>
            <th>NF</th><th>Empresa</th><th>Fundo</th><th>Órgão</th><th>Status</th>
            <th>Liquidada?</th><th>Emissão</th><th>Vencimento</th><th class="right">Valor bruto</th>
          </tr>
        </thead>
        <tbody id="tbl-detalhe-body"></tbody>
      </table>
    </div>
    <div class="legend">
      <b>Em aberto</b>: coluna "Data de realização do pagamento" vazia. &nbsp;
      <b>Paga</b>: coluna preenchida com data. &nbsp;
      <b>Pago (nota)</b>: coluna preenchida com texto (ex.: "PARCIAL EM...", "CONSULTAR EXTRATO", "???") em vez de data — passe o mouse para ver o texto original; requer conferência manual, pois pode não representar quitação total. &nbsp;
      "Liquidada?" é apenas informativa, não entra nos cálculos.
    </div>
  </div>

  <footer>Dados guardados em banco de dados próprio (Supabase) · protegidos por login — só quem entra com a senha vê os números</footer>
</div>
</div>
<script>

function fmtMoney(v){
  return (v || 0).toLocaleString('pt-BR', {style:'currency', currency:'BRL'});
}

function populateFundos(){
  const sel = document.getElementById('f-fundo');
  const current = sel.value;
  sel.innerHTML = '<option value="todos">Todos</option>';
  const fundos = [...new Set(window.NOTAS.filter(n=>n.cedida).map(n=>n.fundo))].sort();
  fundos.forEach(f=>{
    const opt = document.createElement('option');
    opt.value = f; opt.textContent = f;
    sel.appendChild(opt);
  });
  if(fundos.includes(current)) sel.value = current;
}

function getFiltered(){
  const empresa = document.getElementById('f-empresa').value;
  const fundo = document.getElementById('f-fundo').value;
  const status = document.getElementById('f-status').value;

  return window.NOTAS.filter(n=>{
    if(!n.cedida) return false;
    if(empresa !== 'todas' && n.empresa !== empresa) return false;
    if(fundo !== 'todos' && n.fundo !== fundo) return false;
    if(status !== 'todas' && n.status !== status) return false;
    return true;
  });
}

function statusBadge(n){
  if(n.status_display === 'pago_nota'){
    const title = (n.pgto_texto || '').replace(/"/g,'&quot;');
    return '<span class="badge pago_nota" title="'+title+'">Pago (nota)</span>';
  }
  if(n.status === 'paga') return '<span class="badge paga">Paga</span>';
  return '<span class="badge aberto">Em aberto</span>';
}

function render(){
  const filtered = getFiltered();

  const total = filtered.reduce((s,n)=>s + (n.valor_bruto||0), 0);
  const fundosSet = new Set(filtered.map(n=>n.fundo));
  document.getElementById('c-total').textContent = fmtMoney(total);
  document.getElementById('c-count').textContent = filtered.length;
  document.getElementById('c-funds').textContent = fundosSet.size;

  const byFundEmpresa = {};
  filtered.forEach(n=>{
    byFundEmpresa[n.fundo] = byFundEmpresa[n.fundo] || {};
    byFundEmpresa[n.fundo][n.empresa] = byFundEmpresa[n.fundo][n.empresa] || {count:0, total:0};
    byFundEmpresa[n.fundo][n.empresa].count++;
    byFundEmpresa[n.fundo][n.empresa].total += (n.valor_bruto||0);
  });

  const fundosOrdenados = Object.keys(byFundEmpresa).sort();
  let rowsHtml = '';
  let grandTotal = 0, grandCount = 0;

  if(fundosOrdenados.length === 0){
    rowsHtml = '<tr><td colspan="4" class="empty-state">Nenhuma nota encontrada para este filtro.</td></tr>';
  } else {
    fundosOrdenados.forEach(fundo=>{
      const empresas = byFundEmpresa[fundo];
      let subtotal = 0, subcount = 0;
      const empresasOrdenadas = Object.keys(empresas).sort();
      empresasOrdenadas.forEach((emp, idx)=>{
        const d = empresas[emp];
        subtotal += d.total; subcount += d.count;
        rowsHtml += '<tr>'+
          '<td>'+(idx===0 ? fundo : '')+'</td>'+
          '<td>'+emp+'</td>'+
          '<td class="right mono">'+d.count+'</td>'+
          '<td class="right mono">'+fmtMoney(d.total)+'</td>'+
        '</tr>';
      });
      if(empresasOrdenadas.length > 1){
        rowsHtml += '<tr class="subtotal-row">'+
          '<td colspan="2">Subtotal — '+fundo+'</td>'+
          '<td class="right mono">'+subcount+'</td>'+
          '<td class="right mono">'+fmtMoney(subtotal)+'</td>'+
        '</tr>';
      }
      grandTotal += subtotal; grandCount += subcount;
    });
    rowsHtml += '<tr class="grand-total">'+
      '<td colspan="2">Total geral</td>'+
      '<td class="right mono">'+grandCount+'</td>'+
      '<td class="right mono">'+fmtMoney(grandTotal)+'</td>'+
    '</tr>';
  }
  document.getElementById('tbl-fundos-body').innerHTML = rowsHtml;

  const sorted = [...filtered].sort((a,b)=> (a.fundo||'').localeCompare(b.fundo||'') || a.nf - b.nf);
  let detHtml = '';
  if(sorted.length === 0){
    detHtml = '<tr><td colspan="9" class="empty-state">Nenhuma nota encontrada para este filtro.</td></tr>';
  } else {
    sorted.forEach(n=>{
      detHtml += '<tr>'+
        '<td class="mono">'+n.nf+'</td>'+
        '<td>'+n.empresa+'</td>'+
        '<td>'+(n.fundo || '')+'</td>'+
        '<td>'+(n.orgao || '')+'</td>'+
        '<td>'+statusBadge(n)+'</td>'+
        '<td>'+(n.liquidada || '—')+'</td>'+
        '<td>'+(n.emissao || '—')+'</td>'+
        '<td>'+(n.vencimento || '—')+'</td>'+
        '<td class="right mono">'+fmtMoney(n.valor_bruto||0)+'</td>'+
      '</tr>';
    });
  }
  document.getElementById('tbl-detalhe-body').innerHTML = detHtml;
}

['f-empresa','f-fundo','f-status'].forEach(id=>{
  document.getElementById(id).addEventListener('change', render);
});

</script>
<script>

const SUPABASE_URL = "https://nzsnlxactpdoaypagmnl.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im56c25seGFjdHBkb2F5cGFnbW5sIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk5OTM4NzksImV4cCI6MjEwNTU2OTg3OX0.JioAaCCc5DTT_XGYDtB1n5JtDGKxgUr0RfsHJ5Rwh0c";
const LOGIN_FUNCTION_URL = "https://nzsnlxactpdoaypagmnl.supabase.co/functions/v1/login";

const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
  auth: {
    storage: window.sessionStorage,
    persistSession: true,
    autoRefreshToken: true,
    detectSessionInUrl: false,
  },
});

window.NOTAS = [];

function setLoginStatus(msg, kind){
  const el = document.getElementById('login-error');
  el.textContent = msg;
  el.style.color = kind === 'ok' ? 'var(--green)' : '';
}

function setUploadStatus(msg, kind){
  const el = document.getElementById('upload-status');
  el.textContent = msg;
  el.className = 'status-msg' + (kind ? ' ' + kind : '');
}

function showApp(){
  document.getElementById('login-screen').hidden = true;
  document.getElementById('app-content').hidden = false;
}
function showLogin(){
  document.getElementById('app-content').hidden = true;
  document.getElementById('login-screen').hidden = false;
}

async function loadNotas(){
  const { data, error } = await supabaseClient
    .from('notas_fiscais')
    .select('*')
    .order('nf', { ascending: true });
  if(error){
    setUploadStatus('Não consegui carregar os dados: ' + error.message, 'error');
    return;
  }
  window.NOTAS = data || [];
  populateFundos();
  render();
}

async function loadLastUpdate(){
  const { data, error } = await supabaseClient
    .from('notas_fiscais_uploads')
    .select('uploaded_at, total_notas')
    .order('uploaded_at', { ascending: false })
    .limit(1);
  const el = document.getElementById('last-update');
  if(error || !data || data.length === 0){
    el.textContent = 'Nenhuma atualização registrada ainda.';
    return;
  }
  const row = data[0];
  const dt = new Date(row.uploaded_at);
  el.textContent = 'Última atualização: ' + dt.toLocaleString('pt-BR') + ' — ' + row.total_notas + ' notas.';
}

async function trySession(){
  const { data: { session } } = await supabaseClient.auth.getSession();
  if(!session){
    showLogin();
    return;
  }
  showApp();
  await Promise.all([loadNotas(), loadLastUpdate()]);
}

document.getElementById('login-form').addEventListener('submit', async (ev)=>{
  ev.preventDefault();
  const username = document.getElementById('login-user').value.trim();
  const password = document.getElementById('login-pass').value;
  const btn = document.getElementById('login-submit');
  btn.disabled = true;
  setLoginStatus('Entrando...');

  try{
    const resp = await fetch(LOGIN_FUNCTION_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password }),
    });
    const body = await resp.json();
    if(!resp.ok){
      setLoginStatus(body.error || 'Usuário ou senha incorretos.');
      document.getElementById('login-pass').value = '';
      document.getElementById('login-pass').focus();
      return;
    }
    const { error: setError } = await supabaseClient.auth.setSession({
      access_token: body.session.access_token,
      refresh_token: body.session.refresh_token,
    });
    if(setError){
      setLoginStatus('Erro ao iniciar sessão: ' + setError.message);
      return;
    }
    showApp();
    await Promise.all([loadNotas(), loadLastUpdate()]);
  } catch(err){
    setLoginStatus('Erro de conexão. Tente novamente.');
  } finally {
    btn.disabled = false;
  }
});

document.getElementById('logout-btn').addEventListener('click', async ()=>{
  await supabaseClient.auth.signOut();
  window.NOTAS = [];
  document.getElementById('login-user').value = '';
  document.getElementById('login-pass').value = '';
  setLoginStatus('');
  showLogin();
});

// ---- upload de planilha ----

function pad2(n){ return String(n).padStart(2,'0'); }

function fmtDateJs(v){
  if(v === null || v === undefined || v === '') return null;
  if(v instanceof Date && !isNaN(v.getTime())){
    return pad2(v.getDate()) + '/' + pad2(v.getMonth()+1) + '/' + v.getFullYear();
  }
  return String(v).trim();
}

function parseValorJs(v){
  if(v === null || v === undefined || v === '') return {num:null, texto:null};
  if(typeof v === 'number') return {num:v, texto:null};
  const s = String(v).trim();
  const cleaned = s.replace(/[^\d,.\-]/g,'').replace(/\./g,'').replace(',', '.');
  const num = parseFloat(cleaned);
  return {num: isNaN(num) ? null : num, texto: s};
}

function parseWorkbookToNotas(workbook){
  const sheetName = workbook.SheetNames.includes('NF') ? 'NF' : workbook.SheetNames[0];
  const ws = workbook.Sheets[sheetName];
  const aoa = XLSX.utils.sheet_to_json(ws, {header:1, defval:null, raw:true});
  const dataRows = aoa.slice(1);
  const notas = [];

  for(const row of dataRows){
    const empresaRaw = row[0];
    const nf = row[1];
    const orgao = row[2];
    const operada = row[3];
    const liquidada = row[4];
    const valorBrutoRaw = row[5];
    const dtEmissao = row[10];
    const vencimento = row[11];
    const dtPgto = row[12];

    if(nf === null || nf === undefined || nf === '' || isNaN(Number(nf))) continue;
    if(empresaRaw === null || empresaRaw === undefined || String(empresaRaw).trim() === '') continue;

    const empresa = String(empresaRaw).trim();
    const cedida = operada !== null && operada !== undefined && String(operada).trim() !== '';
    const fundo = cedida ? String(operada).trim() : null;

    const {num: valorBrutoNum, texto: valorTexto} = parseValorJs(valorBrutoRaw);

    let isPaga = false, pgtoData = null, pgtoTexto = null;
    if(dtPgto !== null && dtPgto !== undefined && dtPgto !== ''){
      isPaga = true;
      if(dtPgto instanceof Date && !isNaN(dtPgto.getTime())){
        pgtoData = fmtDateJs(dtPgto);
      } else {
        pgtoTexto = String(dtPgto).trim();
      }
    }
    const status = isPaga ? 'paga' : 'aberto';
    const statusDisplay = (isPaga && pgtoTexto) ? 'pago_nota' : status;

    notas.push({
      empresa: empresa,
      nf: Number(nf),
      orgao: orgao,
      fundo: fundo,
      cedida: cedida,
      liquidada: fmtDateJs(liquidada),
      valor_bruto: valorBrutoNum !== null ? Math.round(valorBrutoNum * 100) / 100 : null,
      valor_bruto_texto_original: (typeof valorBrutoRaw === 'string') ? valorTexto : null,
      emissao: fmtDateJs(dtEmissao),
      vencimento: fmtDateJs(vencimento),
      status: status,
      status_display: statusDisplay,
      pgto_data: pgtoData,
      pgto_texto: pgtoTexto,
    });
  }
  return notas;
}

function chunk(arr, size){
  const out = [];
  for(let i=0; i<arr.length; i+=size) out.push(arr.slice(i, i+size));
  return out;
}

document.getElementById('file-input').addEventListener('change', async (ev)=>{
  const file = ev.target.files && ev.target.files[0];
  if(!file) return;
  const label = document.querySelector('label[for="file-input"]');
  label.style.pointerEvents = 'none';
  setUploadStatus('Lendo planilha...', 'pending');

  try{
    const buf = await file.arrayBuffer();
    const wb = XLSX.read(buf, {type:'array', cellDates:true});
    const notas = parseWorkbookToNotas(wb);

    if(notas.length === 0){
      setUploadStatus('Não encontrei notas válidas nessa planilha — confira se é o arquivo certo.', 'error');
      return;
    }

    setUploadStatus('Salvando ' + notas.length + ' notas no banco de dados...', 'pending');

    const { error: delError } = await supabaseClient.from('notas_fiscais').delete().neq('id', -1);
    if(delError){
      setUploadStatus('Falha ao limpar dados antigos: ' + delError.message, 'error');
      return;
    }

    for(const batch of chunk(notas, 500)){
      const { error: insError } = await supabaseClient.from('notas_fiscais').insert(batch);
      if(insError){
        setUploadStatus('Falha ao salvar: ' + insError.message, 'error');
        return;
      }
    }

    await supabaseClient.from('notas_fiscais_uploads').insert({ total_notas: notas.length });

    await Promise.all([loadNotas(), loadLastUpdate()]);
    setUploadStatus(notas.length + ' notas salvas — todos que abrirem esta página já veem os dados novos.', 'success');
  } catch(err){
    setUploadStatus('Erro ao processar o arquivo: ' + (err && err.message ? err.message : err), 'error');
  } finally {
    label.style.pointerEvents = '';
    ev.target.value = '';
  }
});

trySession();

</script>
